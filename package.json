{
  "name": "alexvanwolferen-blog",
  "version": "2.0.0",
  "private": true,
  "description": "A modern blog powered by Next.js and Markdown - Sitecore, tips and tricks",
  "author": "Alex van Wolferen",
  "license": "MIT",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:stable": "playwright test --workers=1 --retries=3",
    "test:repeat": "playwright test --repeat-each=5",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.4",
    "next": "^16.3.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^25.9.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
