{
  "name": "alexvanwolferen-blog",
  "version": "2.0.0",
  "private": true,
  "description": "A modern blog powered by Next.js and Markdown - Sitecore, tips and tricks",
  "author": "Alex van Wolferen",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:stable": "playwright test --workers=1 --retries=3",
    "test:repeat": "playwright test --repeat-each=5",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "date-fns": "^3.6.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "next": "^14.2.21",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@next/eslint-plugin-next": "^16.1.4",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.21",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
